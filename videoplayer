<!DOCTYPE html>
<html>
<head>
    <title>TurboWarp Video Player</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: black; /* Keeps the background clean while loading */
        }
        video {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Fits your ad1.mp4 video perfectly without stretching it */
        }
    </style>
</head>
<body>

    <video autoplay loop muted controls playsinline>
        <source src="ad1.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

</body>
</html>
